# Copy to secrets.yaml (git-ignored, like include/secrets.h previously)
# and replace the placeholders.

wifi_ssid: "REPLACE_WITH_WIFI_SSID"
wifi_password: "REPLACE_WITH_WIFI_PASSWORD"

# For the native ESPHome API (Home Assistant). Generate e.g. with:
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"

# Password for over-the-air updates
ota_password: "REPLACE_WITH_OTA_PASSWORD"

# Password for the fallback hotspot (in case the normal WiFi connection fails)
ap_password: "REPLACE_WITH_AP_PASSWORD"

# Location for the sunset/sunrise automation (sun:) - e.g. https://www.latlong.net/
location_latitude: "REPLACE_WITH_LATITUDE"
location_longitude: "REPLACE_WITH_LONGITUDE"
